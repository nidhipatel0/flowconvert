# Environment Variables for FlowConvert
# Copy this file to .env.local and fill in your values

# App Configuration
NEXT_PUBLIC_APP_NAME=FlowConvert
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature Flags (true/false)
NEXT_PUBLIC_ENABLE_OCR=true
NEXT_PUBLIC_ENABLE_EDGE_DETECTION=true
NEXT_PUBLIC_ENABLE_FILE_HISTORY=true
NEXT_PUBLIC_ENABLE_WORKFLOW_PRESETS=true

# File Upload Limits
NEXT_PUBLIC_MAX_FILE_SIZE_FREE=52428800 # 50MB in bytes
NEXT_PUBLIC_MAX_FILE_SIZE_PREMIUM=524288000 # 500MB in bytes
NEXT_PUBLIC_MAX_BATCH_FILES_FREE=5
NEXT_PUBLIC_MAX_BATCH_FILES_PREMIUM=25

# Server Configuration (for server-side processing)
# SERVER_PROCESSING_TIMEOUT=30000 # 30 seconds in milliseconds

# Analytics (Phase 2)
# NEXT_PUBLIC_ANALYTICS_ID=

# Sentry Error Tracking (Phase 2)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# Vercel (automatically set by Vercel)
# VERCEL_URL=
# VERCEL_ENV=
